# Copy this file to .env and fill in real values. Never commit the real .env.

# LLM (Ollama on the host)
OLLAMA_BASE_URL=http://localhost:11434
LLM_PLANNER=qwen3.8:27b-mlx
LLM_CODER=qwen3.8:27b-mlx
LLM_MATH=qwen3.8:27b-mlx
LLM_ROUTER=qwen3.8:27b-mlx

# Agent memory and runtime
CHROMA_PATH=~/.ds-agent/memory/chroma

# JupyterLab (containerised)
JUPYTER_TOKEN=change-me

# Data sources (fill only the ones you use)
DB_URL_SQLITE=
DB_URL_POSTGRES=
AZURE_SQL_CONN_STR=
MONGODB_URI=
KAFKA_BOOTSTRAP_SERVERS=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_KEY_PATH=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Cloud and BI (optional)
GOOGLE_APPLICATION_CREDENTIALS=
POWERBI_CLIENT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID=

# HPC (optional, for remote training or heavy jobs)
HPC_SCHEDULER=
HPC_HOST_RAAPOI=
HPC_HOST_AVIDA=
HPC_HOST_HIGH01=
HPC_SSH_KEY=

# Monitoring and retraining (optional)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
PRIMARY_METRIC=
METRIC_GATE_MARGIN=
PSI_RETRAIN_THRESHOLD=
FEEDBACK_RETRAIN_DELTA=
MAX_QUERY_COST_USD=

# Optional agent behaviour flags (defaults shown; set to override)
# DSAGENT_MULTIAGENT=1
# DSAGENT_ALLOW_WRITES=0
# DSAGENT_CRITIC=1
# DSAGENT_NUM_CTX=16384
# DSAGENT_MAX_ORCH_ROUNDS=6
# DSAGENT_SPECIALIST_STEPS=6
